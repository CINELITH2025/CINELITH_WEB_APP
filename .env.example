# =====================================================================
# CINELITH ENVIRONMENT VARIABLES SPECIFICATION
# Copy this file to .env in backend/ or set these keys in Vercel Dashboard
# =====================================================================

# Server Configuration
NODE_ENV=production
PORT=5050

# MongoDB Database URI (MongoDB Atlas Cloud Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=cinelith_production_jwt_secret_2025

# Transactional Email (Resend API SDK)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=CINELITH <team@cinelith.com>

# Optional Nodemailer Fallback SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=team@cinelith.com
EMAIL_PASS=your_gmail_app_password

# Frontend API URL (Leave blank on Vercel to auto-route /api to serverless functions)
VITE_API_URL=
